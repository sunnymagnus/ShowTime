{
  "name": "showtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Hyderabad cinema booking application with an Express server and SQLite database.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/api.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write client server shared tests *.json *.ts *.html docs README.md .vscode .github"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
